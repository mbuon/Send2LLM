{
  "name": "send2llm-extension",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "vite build && ENTRY=content vite build",
    "build:chrome": "BROWSER=chrome vite build && BROWSER=chrome ENTRY=content vite build",
    "build:firefox": "BROWSER=firefox vite build && BROWSER=firefox ENTRY=content vite build",
    "build:edge": "BROWSER=edge vite build && BROWSER=edge ENTRY=content vite build",
    "dev:chrome": "BROWSER=chrome vite build --watch",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "jszip": "^3.10.1",
    "webextension-polyfill": "^0.12.0"
  },
  "devDependencies": {
    "@types/chrome": "^0.0.268",
    "@types/firefox-webext-browser": "^120.0.0",
    "@types/node": "^20.14.0",
    "@types/webextension-polyfill": "^0.10.7",
    "typescript": "^5.5.0",
    "vite": "^5.3.0",
    "vitest": "^1.6.0"
  }
}
